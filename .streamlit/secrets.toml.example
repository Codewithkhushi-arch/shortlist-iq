# Streamlit Secrets Template for ShortlistIQ
# For local dev: copy this file to .streamlit/secrets.toml and fill in your keys
# For Streamlit Community Cloud: paste these key-value pairs into App Settings -> Secrets

GOOGLE_API_KEY = "AIzaSy..."
# Optional alternative variable name:
GEMINI_API_KEY = "AIzaSy..."

# Admin password for the /analytics dashboard (Default: admin123)
ADMIN_PASSWORD = "admin"
